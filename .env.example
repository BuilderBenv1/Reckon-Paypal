# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox). Never commit real values.
# The app needs Invoicing, Payouts and Transaction Search turned on.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional. Send every payout to this sandbox personal account so it settles as SUCCESS.
# Leave it unset for the full story: payouts to the invented supplier emails sit UNCLAIMED,
# which is what lets the returned-payment incident run on the real sandbox.
PAYPAL_SANDBOX_RECEIVER=

# Anthropic API key: Claude reads emails and drafts supplier/customer messages.
# Leave blank to use the deterministic fixture reader and the message templates.
ANTHROPIC_API_KEY=

# ---- web app (Vercel) ----
# Supabase project (run supabase/migrations/0001_reckon.sql first). Without these,
# runs live in server memory: fine for `npm run dev`, not for Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Code people must enter to start a live sandbox run from the web app.
RECKON_LIVE_CODE=
# Id of the PayPal webhook pointing at /api/webhooks/paypal (subscribe to INVOICING.INVOICE.PAID,
# PAYMENT.PAYOUTS-ITEM.* and PAYMENT.PAYOUTSBATCH.*). Used to verify each delivery with PayPal.
PAYPAL_WEBHOOK_ID=
# Set to 1 to let public demo runs use Claude (capped per run).
RECKON_DEMO_CLAUDE=
# Optional. Vercel sends it to /api/cron/keepalive (the daily ping that stops Supabase pausing).
CRON_SECRET=
# Optional: a human voice for the guided demo (ElevenLabs). Each line is voiced once and cached
# in the Supabase `narration` bucket (migration 0002). Without a key the browser's voice is used.
ELEVENLABS_API_KEY=
# Optional. Defaults to "George" (JBFqnCBsd6RMkjVDRZzb) on eleven_v4; eleven_multilingual_v2 also works.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Optional, 0 to 1. Unset uses the voice's own settings; lower sounds more expressive.
ELEVENLABS_STABILITY=
# Optional. The guided demo ends "Now, over to <name>." when the page is opened with ?handoff.
RECKON_PRESENTER=
